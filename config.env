# Configurazione non segreta. Ogni valore si può sovrascrivere con una
# variabile d'ambiente dello stesso nome nel template vast.ai.
# I SEGRETI (token, chiavi del bucket) NON vanno qui: vedi README.

WORKSPACE="${WORKSPACE:-/workspace}"

# --- GPU ---
COMFY_GPU="${COMFY_GPU:-0}"
OLLAMA_GPU="${OLLAMA_GPU:-1}"

# --- ComfyUI ---
COMFY_PORT="${COMFY_PORT:-8188}"
# 127.0.0.1 = raggiungibile solo dal tunnel SSH (consigliato).
# 0.0.0.0   = esposto sulla porta pubblica mappata da vast (-p 8188:8188).
COMFY_LISTEN="${COMFY_LISTEN:-127.0.0.1}"
COMFY_ARGS="${COMFY_ARGS:-}"           # es. "--highvram" o "--preview-method auto"
COMFY_UPDATE="${COMFY_UPDATE:-0}"      # 1 = git pull di ComfyUI a ogni avvio

# --- Ollama ---
OLLAMA_PORT="${OLLAMA_PORT:-11434}"
OLLAMA_LISTEN="${OLLAMA_LISTEN:-127.0.0.1}"   # Ollama non ha autenticazione: lascialo su 127.0.0.1
OLLAMA_KEEP_ALIVE="${OLLAMA_KEEP_ALIVE:-24h}"
OLLAMA_MODELS_DIR="${OLLAMA_MODELS_DIR:-$WORKSPACE/ollama-models}"
GGUF_DIR="${GGUF_DIR:-$WORKSPACE/gguf}"

# --- Sincronizzazione intera da bucket (opzionale) ---
# Una cartella del bucket con la stessa struttura di ComfyUI/models
# (loras/, checkpoints/, vae/ ...) viene copiata tutta. Lascia vuoto per non usarla.
COMFY_MODELS_SYNC="${COMFY_MODELS_SYNC:-}"    # es. s3://mio-bucket/comfyui/models/
# Una cartella del bucket con file .gguf: ognuno diventa un modello Ollama.
GGUF_SYNC="${GGUF_SYNC:-}"                    # es. s3://mio-bucket/gguf/
